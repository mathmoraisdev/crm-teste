# ─────────────────────────────────────────────────────────────
# Banco de dados (Postgres via docker-compose)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# ─────────────────────────────────────────────────────────────
# IA — ÚNICA CREDENCIAL OBRIGATÓRIA
# A qualificação/conversa é sempre real (núcleo do teste). Não há mock de IA.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# Tiers de modelo (já têm defaults sensatos no código)
AI_MODEL_CHEAP="claude-haiku-4-5"      # classificação / próxima pergunta (barato)
AI_MODEL_STRONG="claude-sonnet-4-6"    # qualificação estruturada / decisões

# ─────────────────────────────────────────────────────────────
# WhatsApp — "mock" (padrão, roda local) | "cloud-api" (Meta Graph API)
# ─────────────────────────────────────────────────────────────
WHATSAPP_MODE="mock"
# Necessário apenas em WHATSAPP_MODE=cloud-api:
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="meu-verify-token"

# ─────────────────────────────────────────────────────────────
# Calendar — "mock" (padrão, roda local) | "google-calendar"
# ─────────────────────────────────────────────────────────────
CALENDAR_MODE="mock"
# Necessário apenas em CALENDAR_MODE=google-calendar:
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID="primary"

# Fuso usado para propor horários de reunião
SCHEDULING_TIMEZONE="America/Sao_Paulo"
