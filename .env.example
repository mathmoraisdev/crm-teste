# ─────────────────────────────────────────────────────────────
# Banco de dados (Postgres via docker-compose)
# ─────────────────────────────────────────────────────────────
# DATABASE_URL = conexão de runtime. Em PRODUÇÃO/Vercel use o pooler de
# transação do Supabase (porta 6543) + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
# DIRECT_URL = conexão direta (porta 5432), usada por `prisma db push`/migrations.
# Em dev local aponte para o mesmo banco do DATABASE_URL.
# Em produção use o "session pooler"/conexão direta do Supabase (5432).
DIRECT_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# ─────────────────────────────────────────────────────────────
# IA — ÚNICA CREDENCIAL OBRIGATÓRIA
# A qualificação/conversa é sempre real (núcleo do teste). Não há mock de IA.
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=""

# Tiers de modelo (já têm defaults sensatos no código)
AI_MODEL_CHEAP="gpt-4o-mini"           # classificação / próxima pergunta (barato)
AI_MODEL_STRONG="gpt-4o"               # qualificação estruturada / decisões

# ─────────────────────────────────────────────────────────────
# WhatsApp — "mock" (padrão, roda local) | "cloud-api" (Meta Graph API)
# ─────────────────────────────────────────────────────────────
WHATSAPP_MODE="mock"
# Necessário apenas em WHATSAPP_MODE=cloud-api:
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="meu-verify-token"

# ─────────────────────────────────────────────────────────────
# Calendar — "mock" (padrão, roda local) | "google-calendar"
# ─────────────────────────────────────────────────────────────
CALENDAR_MODE="mock"
# Necessário apenas em CALENDAR_MODE=google-calendar:
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID="primary"

# Fuso usado para propor horários de reunião
SCHEDULING_TIMEZONE="America/Sao_Paulo"

# ─────────────────────────────────────────────────────────────
# Deliverability — disparo seguro (Caminho A / Cloud API)
# ─────────────────────────────────────────────────────────────
WHATSAPP_DAILY_CAP="1000"          # teto diário (começar baixo no warm-up!)
WHATSAPP_MIN_INTERVAL_MS="8000"    # intervalo mínimo entre envios
WHATSAPP_JITTER_MS="4000"          # variação aleatória somada ao intervalo
WHATSAPP_SEND_START_HOUR="9"       # início da janela comercial
WHATSAPP_SEND_END_HOUR="18"        # fim (exclusivo) da janela
WHATSAPP_TEMPLATE_NAME=""          # nome do template aprovado p/ cold outbound
WHATSAPP_TEMPLATE_LANG="pt_BR"
WHATSAPP_APP_SECRET=""             # App Secret p/ validar assinatura do webhook
WORKER_POLL_MS="2000"              # frequência de polling do worker
CRON_SECRET=""                     # segredo da rota /api/cron/dispatch (Vercel Cron) — só mock/cloud-api

# ─────────────────────────────────────────────────────────────
# Baileys — transporte não-oficial multi-número (WHATSAPP_MODE=baileys)
# ─────────────────────────────────────────────────────────────
BAILEYS_AUTH_DIR=".baileys-auth"      # pasta-base das sessões (1 subpasta por número)
BAILEYS_PER_NUMBER_DAILY_CAP="30"     # teto diário POR CHIP no warm-up (suba devagar!)
BAILEYS_ONWHATSAPP_CHECK="true"       # verifica se o número existe no WhatsApp antes de enviar
BAILEYS_TYPING_MS_PER_CHAR="55"       # ms de "digitando" por caractere (simulação humana)
BAILEYS_TYPING_MAX_MS="9000"          # teto do tempo de digitação
