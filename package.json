{
  "name": "mini-crm-prospeccao-ia",
  "version": "1.0.0",
  "private": true,
  "description": "Mini CRM de prospecção com IA — qualificação automática de leads via WhatsApp",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "worker": "tsx --env-file-if-exists=.env src/server/worker/run.ts",
    "worker:prod": "tsx src/server/worker/run.ts",
    "wa:link": "tsx --env-file-if-exists=.env scripts/wa-link.ts",
    "ai:smoke": "tsx --env-file-if-exists=.env scripts/ai-smoke.ts",
    "seed:test": "tsx --env-file-if-exists=.env scripts/seed-test-leads.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.16.0",
    "@whiskeysockets/baileys": "^6.17.16",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.0",
    "openai": "^6.44.0",
    "papaparse": "^5.4.1",
    "pino": "^10.3.1",
    "posthog-js": "^1.390.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
