// Mini CRM de Prospecção com IA — modelagem do domínio.
// MVP usa `prisma db push`; migrations versionadas ficam como nota de produção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url = conexão de runtime (na Vercel: pooler de transação 6543, com pgbouncer).
  url       = env("DATABASE_URL")
  // directUrl = conexão direta (5432) usada por `db push`/migrations/introspect,
  // que não funcionam pelo pgbouncer. Em dev local aponte para o mesmo Postgres.
  directUrl = env("DIRECT_URL")
}

enum AiProvider {
  OPENAI
  ANTHROPIC
}

enum PaymentProvider {
  MERCADO_PAGO
  ASAAS
}

enum SaleStatus {
  PENDING // cobrança criada, aguardando pagamento
  PAID // confirmado via webhook + reconsulta na API
  EXPIRED // Pix expirou sem pagamento
  CANCELED // cancelado manualmente
}

enum BillingOverride {
  AUTO // segue o prazo (accessUntil)
  ACTIVE // forçado ativo pelo admin (ganha da data)
  SUSPENDED // forçado suspenso pelo admin (ganha da data)
}

enum PaymentMethod {
  PIX
  CARTAO
  BOLETO
  TRANSFERENCIA
}

enum CatalogItemKind {
  SERVICO
  PRODUTO
}

enum OrderStatus {
  ABERTA
  FECHADA
}

// Forma de pagamento da COMANDA. Enum próprio (o PaymentMethod existente é do
// billing e não tem DINHEIRO, que o balcão precisa).
enum OrderPayment {
  DINHEIRO
  PIX
  CARTAO
  OUTRO
}

enum StockMovementKind {
  ENTRADA // compra/reposição (+)
  SAIDA // venda: baixa por comanda fechada (−)
  AJUSTE // inventário/correção/perda (+/−)
}

enum ExpenseCategory {
  ALUGUEL // aluguel/ocupação
  FORNECEDOR // mercadoria/insumo
  PESSOAL // salário/pró-labore/comissão
  CONTAS // luz/água/internet/telefone
  IMPOSTOS // impostos/taxas
  OUTRO
}

enum ExpenseStatus {
  PENDENTE
  PAGA
}

enum Plan {
  INICIAL
  PROFISSIONAL
  ESCALA
}

enum AccountRole {
  ADMIN // dono da conta — billing, equipe, números
  OPERADOR // atende/CRM; sem billing nem gestão de equipe
}

// Tipo de aviso que o admin da plataforma recebe no /financeiro.
enum AccountNoticeKind {
  CANCELAMENTO // o dono pediu p/ cancelar a assinatura (conta ainda existe)
  EXCLUSAO // o dono excluiu a conta (dados já apagados; sobra só este aviso)
}

// Escopo de leads visível a um operador (ignorado no dono/ADMIN).
enum LeadsScope {
  ALL // vê todos os leads da conta
  ASSIGNED // vê só os leads atribuídos a ele
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique // login (normalizado lowercase)
  whatsapp           String? // telefone informado no cadastro (opcional)
  passwordHash       String // scrypt$salt$hash
  emailVerified      DateTime? // null = e-mail ainda não confirmado
  sessionEpoch       Int             @default(0) // versão da sessão; trocar/resetar senha incrementa e invalida cookies antigos
  // Prazo de acesso (trial ou pago): a conta funciona enquanto `accessUntil` está
  // no futuro. Expira em tempo real (sem cron) — os gates comparam na hora.
  // `billingOverride` permite forçar/liberar manualmente preservando a data.
  accessUntil        DateTime?
  billingOverride    BillingOverride @default(AUTO)
  // Anotação financeira (NÃO afeta o acesso — só registro do admin): como o
  // cliente paga e quando vence a próxima mensalidade. Ambos opcionais.
  paymentMethod      PaymentMethod?
  paymentDueDate     DateTime?
  // Cancelamento self-service pelo DONO: null = assinatura ativa; preenchido = o
  // cliente pediu para não renovar. NÃO corta acesso nem apaga dados — o acesso
  // segue até `accessUntil` e a conta expira sozinha na validade. Sinaliza ao
  // admin no /financeiro. O dono pode reativar (volta a null) antes de expirar.
  cancelRequestedAt  DateTime?
  // Plano comercial do DONO (null = não definido → entitlements não aplicados).
  // O admin define no /financeiro. Só faz sentido no dono (ownerId = null).
  plan               Plan?
  // Ramo do negócio da conta (id de BUSINESS_TEMPLATES, ex.: "barbearia"). Fonte
  // de verdade da vertical no NÍVEL CONTA — pré-seleciona o modelo de Atendimento
  // dos números e habilita semear o catálogo. Só faz sentido no dono (ownerId=null).
  businessTemplateId String?
  // Papel dentro da conta. Dono = ADMIN; operadores criados pelo admin = OPERADOR.
  role               AccountRole     @default(ADMIN)
  // Limitações configuráveis do OPERADOR (o admin define no /equipe). No dono/ADMIN
  // são ignoradas — ele sempre tem acesso total. Enforced no servidor (rotas de API).
  canCampaigns       Boolean         @default(true) // pode criar/disparar campanhas
  canSettings        Boolean         @default(true) // pode editar Configurações/IA da conta
  leadsScope         LeadsScope      @default(ALL) // ALL = todos os leads; ASSIGNED = só os atribuídos
  // Rótulos renomeados das etapas do funil (sobrepõem LEAD_STATUS_META.label).
  // Mapa { LeadStatus: "novo rótulo" }. O enum em si NÃO muda (a IA depende dele).
  pipelineLabels     Json?
  // Tenancy por dono: null = este User É o dono (tenant). Preenchido = operador
  // que compartilha os dados do dono. Billing/plano só fazem sentido no dono.
  ownerId            String?
  owner              User?           @relation("AccountMembers", fields: [ownerId], references: [id], onDelete: Cascade)
  members            User[]          @relation("AccountMembers")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // BYOK: credencial de IA do usuário (null = usa a chave da plataforma).
  aiProvider      AiProvider? // OPENAI | ANTHROPIC | null
  aiKeyEnc        String? // chave cifrada (AES-256-GCM): "iv:tag:ciphertext"
  aiKeyLast4      String? // 4 últimos dígitos p/ exibir na UI sem revelar
  aiKeyVerifiedAt DateTime? // última validação bem-sucedida contra a API

  // Cota de IA na chave da PLATAFORMA (BYOK ignora). Reset por virada de mês,
  // em tempo real (sem cron): se aiCreditMonth != mês atual, o contador zera.
  aiCreditMonth String? // "YYYY-MM" — mês de referência do contador
  aiCreditUsed  Int     @default(0) // atendimentos de IA consumidos no mês corrente

  // BYOK de pagamento: credencial do gateway do cliente (null = vendas desligadas).
  paymentProvider      PaymentProvider? // MERCADO_PAGO | ASAAS | null
  paymentKeyEnc        String? // token cifrado (AES-256-GCM): "iv:tag:ciphertext"
  paymentKeyLast4      String? // 4 últimos p/ exibir na UI
  paymentKeyVerifiedAt DateTime? // última validação bem-sucedida contra o gateway

  offers Offer[]
  sales  Sale[]

  leads                    Lead[]
  assignedLeads            Lead[]                   @relation("AssignedLeads")
  tags                     Tag[]
  customFieldDefs          CustomFieldDef[]
  campaigns                Campaign[]
  whatsAppNumbers          WhatsAppNumber[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  payments                 Payment[]                @relation("AccountPayments") // pagamentos DESTA conta (receita)
  registeredPayments       Payment[]                @relation("RegisteredPayments") // pagamentos que ESTE admin lançou
  branding                 AccountBranding?
  catalogItems             CatalogItem[]
  orders                   Order[]                  @relation("OrderAccount")
  ordersOpened             Order[]                  @relation("OrderOpenedBy")
  expenses                 Expense[]                @relation("ExpenseAccount")
  expensesCreated          Expense[]                @relation("ExpenseCreatedBy")
  recurringExpenses        RecurringExpense[]       @relation("RecurringExpenseAccount")
  recurringExpensesCreated RecurringExpense[]       @relation("RecurringExpenseCreatedBy")
  stockMovements           StockMovement[]          @relation("StockMovementAccount")
  stockMovementsCreated    StockMovement[]          @relation("StockMovementCreatedBy")
  createdAppointments      Appointment[]            @relation("AppointmentCreatedBy")
}

// Ledger de receita: cada pagamento lançado pelo admin é um registro imutável.
// Fonte de verdade da RECEITA (o acesso continua em User.accessUntil). Reembolso,
// no futuro, é um lançamento à parte (amountCents negativo) — não editamos linha.
model Payment {
  id             String         @id @default(cuid())
  accountId      String // conta que pagou (User.id)
  account        User           @relation("AccountPayments", fields: [accountId], references: [id], onDelete: Cascade)
  amountCents    Int // valor em centavos (BRL). > 0 no lançamento normal.
  method         PaymentMethod? // forma usada NESTE pagamento (snapshot; pode diferir do padrão da conta)
  paidAt         DateTime       @default(now()) // quando entrou (data do lançamento) — base da "receita do mês"
  coversUntil    DateTime? // até quando este pagamento estendeu o acesso (snapshot do accessUntil resultante)
  note           String? // observação livre do admin (opcional)
  // Quem lançou (admin). Nullable: lançamentos antigos / scripts podem não ter autor.
  registeredById String?
  registeredBy   User?          @relation("RegisteredPayments", fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([accountId])
  @@index([paidAt])
}

// Aviso para o admin da plataforma: cancelamento/exclusão de conta. Append-only e
// SEM FK para User de propósito — precisa sobreviver ao delete em cascade da conta
// (senão a exclusão apagaria o próprio aviso). Guarda um snapshot de nome/e-mail.
model AccountNotice {
  id           String            @id @default(cuid())
  kind         AccountNoticeKind
  accountName  String // snapshot no momento do evento
  accountEmail String // snapshot (conta pode já não existir)
  plan         Plan? // plano no momento do evento (contexto p/ o admin)
  createdAt    DateTime          @default(now())
  seenAt       DateTime? // admin visualizou (null = não lido → conta no badge)

  @@index([seenAt])
  @@index([createdAt])
}

// Identidade visual da conta (branding multivertical). 1:1 com o DONO da conta.
// Ausência = paleta default (verde). Só o accent `brand` é temável nesta versão.
model AccountBranding {
  id        String @id @default(cuid())
  accountId String @unique // User.id do dono (tenantUserId)
  account   User   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  presetId   String? // id do preset aplicado (ex.: "beleza-rose"); null = default/custom
  brandScale Json? // BrandPalette { "50": "R G B", ... }; null = usa DEFAULT_PALETTE
  logoUrl    String? // URL pública do logo no Storage; null = logo padrão
  appName    String? // nome exibido no lugar de "Disparador.ai"; null = padrão

  // --- Impressão de cupom (N2, opt-in por conta) ---
  printMode   String? // null/"browser" = imprime pelo navegador (N1); "escpos" = QZ Tray
  printerName String? // nome da impressora no QZ Tray (quando printMode=escpos)
  openDrawer  Boolean @default(false) // abre a gaveta no pagamento em dinheiro (N2.3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Item vendável do catálogo da conta (serviço ou produto). Fonte de verdade do
// preço. Por DONO (tenant), não por número de WhatsApp (diferente de Offer, que
// é do funil de Pix). Ausência de catálogo = conta ainda não cadastrou nada.
model CatalogItem {
  id           String          @id @default(cuid())
  accountId    String // User.id do dono (tenantUserId)
  account      User            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         CatalogItemKind @default(SERVICO)
  name         String
  priceCents   Int // preço em centavos (BRL)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  orderItems   OrderItem[]
  appointments Appointment[]

  // --- Controle de estoque (opt-in; só faz sentido em kind = PRODUTO) ---
  trackStock     Boolean         @default(false) // liga o controle p/ este item
  sku            String? // código interno opcional
  stockQty       Int             @default(0) // saldo atual (desnormalizado; = Σ dos movimentos)
  minStock       Int             @default(0) // alerta quando stockQty <= minStock
  costCents      Int? // custo unitário em centavos (opcional; p/ valor em estoque)
  stockMovements StockMovement[]

  // --- Comanda de cozinha (N3): roteia o item p/ a impressora do setor ---
  printSector String? // ex.: "cozinha", "bar", "balcao"; null = não vai p/ produção

  @@index([accountId, active])
  @@index([accountId, trackStock])
}

// Comanda: uma venda/atendimento registrado. Liga a um Lead do CRM OU é avulsa
// (customerName). O total é DERIVADO dos itens (não desnormalizado).
model Order {
  id             String          @id @default(cuid())
  accountId      String // User.id do dono (tenant)
  account        User            @relation("OrderAccount", fields: [accountId], references: [id], onDelete: Cascade)
  leadId         String? // opcional: comanda ligada a um lead
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerName   String? // nome avulso quando não há lead
  status         OrderStatus     @default(ABERTA)
  openedById     String // User.id de quem abriu (operador) — atribuição p/ relatório futuro
  openedBy       User            @relation("OrderOpenedBy", fields: [openedById], references: [id])
  payment        OrderPayment? // definido no fechamento
  note           String?
  customFields   Json? // valores dos CustomFieldDef scope=ORDER (chaveado por `key`)
  createdAt      DateTime        @default(now())
  closedAt       DateTime? // quando foi fechada (FECHADA)
  number         Int? // nº sequencial do cupom POR conta; atribuído no fechamento (null = comanda antiga)
  // Camada financeira (POS): ajustes sobre Σ itens. O total continua DERIVADO —
  // estes campos são ENTRADAS do cálculo, nunca o total desnormalizado.
  discountCents       Int? // desconto da comanda (valor OU % resolvido na borda → centavos)
  surchargeCents      Int? // acréscimo / taxa de serviço
  tipCents            Int? // gorjeta estruturada
  amountTenderedCents Int? // valor recebido (dinheiro) — base do troco
  changeCents         Int? // troco derivado no fechamento (max(0, recebido − total))
  tableLabel          String? // mesa/comanda física (rótulo livre)
  items          OrderItem[]
  stockMovements StockMovement[]
  appointments   Appointment[]

  @@unique([accountId, number]) // sequencial por conta; NULLs coexistem (Postgres trata como distintos)
  @@index([accountId, status])
  @@index([accountId, closedAt])
}

// Linha de uma comanda. Guarda SNAPSHOT de nome/preço: reajustar o catálogo
// depois não altera comandas antigas. catalogItemId é opcional (permite linha
// avulsa e sobrevive à exclusão do item do catálogo).
model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItemId  String?
  catalogItem    CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int          @default(1)
  customFields   Json? // valores dos CustomFieldDef scope=ORDER_ITEM (chaveado por `key`)
  createdAt      DateTime     @default(now())

  @@index([orderId])
}

// Livro-razão imutável de estoque: cada variação de saldo é uma linha (append-only).
// delta = variação aplicada (+entrada, −saída); balanceAfter = saldo resultante
// (snapshot p/ auditoria e reconciliação com CatalogItem.stockQty). orderId liga a
// baixa à comanda que a gerou (SAIDA).
model StockMovement {
  id            String            @id @default(cuid())
  accountId     String
  account       User              @relation("StockMovementAccount", fields: [accountId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem       @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  kind          StockMovementKind
  delta         Int // +entrada / −saída / ± ajuste
  balanceAfter  Int // saldo do item após aplicar o delta
  reason        String? // nota livre (fornecedor, "inventário", "perda")
  orderId       String? // comanda de origem (quando SAIDA)
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  unitCostCents Int? // custo unitário no caso de ENTRADA (snapshot)
  createdById   String
  createdBy     User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([accountId, catalogItemId, createdAt])
  @@index([orderId])
}

// Despesa / conta a pagar da conta. Pode ser AVULSA ou uma materialização de uma
// despesa recorrente (recurringId). Regime de CAIXA: entra no "saldo" quando PAGA
// (paidAt no período), não quando vence. Snapshot imutável: editar o RecurringExpense
// NÃO altera instâncias já geradas (igual OrderItem x CatalogItem).
model Expense {
  id              String            @id @default(cuid())
  accountId       String // User.id do dono (tenant)
  account         User              @relation("ExpenseAccount", fields: [accountId], references: [id], onDelete: Cascade)
  description     String
  amountCents     Int // valor em centavos (BRL), >= 0
  category        ExpenseCategory   @default(OUTRO)
  status          ExpenseStatus     @default(PENDENTE)
  dueDate         DateTime // vencimento (data da conta); base do "a vencer/vencidas"
  paidAt          DateTime? // quando foi paga; base do saldo (regime de caixa)
  note            String?
  createdById     String // quem lançou (operador/dono)
  createdBy       User              @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  // Origem recorrente (null = avulsa). competenceMonth "YYYY-MM" garante 1 por mês.
  recurringId     String?
  recurring       RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  competenceMonth String? // "YYYY-MM" quando veio de recorrência; null quando avulsa
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Idempotência da geração mensal. Avulsas têm (null, null) → Postgres trata NULLs
  // como distintos, então várias avulsas coexistem sem colidir.
  @@unique([recurringId, competenceMonth])
  @@index([accountId, status, dueDate])
  @@index([accountId, paidAt])
}

// Modelo de despesa fixa mensal (aluguel, salário, internet). Gera UMA Expense
// PENDENTE por mês, de forma idempotente. Desativar para parar de gerar.
model RecurringExpense {
  id          String          @id @default(cuid())
  accountId   String
  account     User            @relation("RecurringExpenseAccount", fields: [accountId], references: [id], onDelete: Cascade)
  description String
  amountCents Int
  category    ExpenseCategory @default(OUTRO)
  dayOfMonth  Int // dia do vencimento (1..31; clampa ao último dia em meses curtos)
  active      Boolean         @default(true)
  createdById String
  createdBy   User            @relation("RecurringExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  expenses    Expense[]

  @@index([accountId, active])
}

enum LeadStatus {
  NOVO
  CONTATADO
  EM_CONVERSA
  QUALIFICADO
  REUNIAO_AGENDADA
  OFERTA_ENVIADA // oferta apresentada + Pix enviado, aguardando pagamento
  PAGO // pagamento confirmado
  DESCARTADO
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// Origem de uma mensagem OUTBOUND (null = INBOUND do lead ou linha legada).
// Usado p/ separar métrica de tempo de resposta da IA vs. do atendente humano.
enum MessageSource {
  AI // resposta conversacional gerada pela IA
  OPERATOR // resposta humana (inbox CRM ou digitada no próprio WhatsApp)
  CAMPAIGN // disparo de campanha (template/freeform)
  SYSTEM // automatismo sem ser resposta (lembrete de reunião, etc.)
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED // pausada pelo gate de qualidade
  COMPLETED
}

enum OutboundJobStatus {
  PENDING // aguardando o worker
  SENDING // travado por um worker (evita envio duplo)
  SENT // enviado com sucesso
  FAILED // falhou após retries
  CANCELLED // lead deu opt-out / campanha cancelada
}

enum MeetingStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
}

// Camada de workflow humano sobre a conversa (derivada de aiPaused + atribuição).
enum AttendanceStatus {
  IA // IA atende (fora do inbox humano)
  FILA // aguardando um atendente assumir
  ATENDENDO // operador atribuído, em atendimento
  AGUARDANDO // operador respondeu, aguardando o cliente
  RESOLVIDA // encerrada
}

enum WhatsAppNumberStatus {
  CONNECTING // pareando / subindo socket
  CONNECTED // saudável, pode enviar
  WARMING // conectado, mas em warm-up (cap reduzido)
  PAUSED // pausado manualmente
  LOGGED_OUT // aparelho deslogado (401) — precisa reescanear; configs preservadas
  BANNED // 403 detectado — ban efetivo, fora da rotação
  DISABLED // desativado pelo operador
}

enum PersonType {
  PF
  PJ
}

model Lead {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  phone             String // E.164 normalizado — único POR conta (ver @@unique abaixo)
  email             String? // capturado pela IA na conversa (ou informado manualmente)
  personType        PersonType       @default(PF)
  document          String? // CPF (PF) ou CNPJ (PJ), só dígitos; opcional
  status            LeadStatus       @default(NOVO)
  score             Int              @default(0)
  campaign          Campaign?        @relation(fields: [campaignId], references: [id])
  campaignId        String?
  messages          Message[]
  qualification     Qualification?
  meeting           Meeting?
  sales             Sale[]
  orders            Order[]
  appointments      Appointment[]
  optOut            Boolean          @default(false)
  optOutAt          DateTime?
  consentSource     String? // origem do opt-in (LGPD)
  tags              Tag[]            @relation("LeadTags")
  customFields      Json? // valores dos CustomFieldDef da conta (chaveado por `key`)
  // IA pausada manualmente p/ este lead (handover humano)
  aiPaused          Boolean          @default(false)
  aiPausedAt        DateTime?
  // Sinal p/ o worker: IA reativada (devolução/resolve) com inbound pendente →
  // responde a backlog sem esperar nova mensagem do lead. O worker consome e limpa.
  aiResumePendingAt DateTime?
  // ── Atendimento humano (inbox / multiatendimento) ──────────────────────
  attendanceStatus  AttendanceStatus @default(IA)
  assignedTo        User?            @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId      String?
  queuedAt          DateTime? // entrou na FILA (base do SLA)
  firstResponseAt   DateTime? // 1ª resposta humana após a fila (fecha o SLA)
  lastReadAt        DateTime? // leitura (inbox compartilhado)
  outboundJobs      OutboundJob[]
  // chip "dono" da conversa, p/ responder pelo mesmo número (Baileys multi-número)
  whatsAppNumber    WhatsAppNumber?  @relation(fields: [whatsAppNumberId], references: [id])
  whatsAppNumberId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Identidade da conversa é por EMPRESA (número), não por operador:
  // a mesma pessoa pode falar com 2 empresas suas = 2 conversas distintas.
  @@unique([whatsAppNumberId, phone])
  @@index([userId])
  @@index([userId, updatedAt]) // ordenamento paginado por conta (listLeads)
  @@index([userId, status])
  @@index([status])
  @@index([userId, attendanceStatus])
  @@index([assignedToId])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum CustomFieldScope {
  LEAD
  ORDER
  ORDER_ITEM
}

// Definição de um campo customizado por conta. O valor vive em `Lead.customFields`,
// `Order.customFields` ou `OrderItem.customFields` (Json), chaveado por `key`,
// conforme o `scope`.
model CustomFieldDef {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  key       String // slug estável (chave no Json)
  label     String
  type      CustomFieldType  @default(TEXT)
  scope     CustomFieldScope @default(LEAD)
  options   Json? // SELECT: ["A","B"]
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  @@unique([userId, scope, key])
  @@index([userId])
}

// Etiqueta colorida por conta, atribuível a vários leads (N:N).
model Tag {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  color     String   @default("slate") // chave de Tone (Badge)
  leads     Lead[]   @relation("LeadTags")
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model Message {
  id                String           @id @default(cuid())
  lead              Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId            String
  direction         MessageDirection
  content           String
  providerMessageId String?          @unique // dedupe de webhook
  status            MessageStatus?
  // origem do OUTBOUND (null em INBOUND e em linhas anteriores a este campo)
  source            MessageSource?
  // qual chip enviou/recebeu — auditoria (Baileys multi-número)
  whatsAppNumber    WhatsAppNumber?  @relation(fields: [whatsAppNumberId], references: [id])
  whatsAppNumberId  String?
  // Citação (reply): mensagem desta thread que esta responde. OUTBOUND = operador
  // citou pelo CRM; INBOUND = lead citou uma msg nossa (resolvida pelo stanzaId do
  // Baileys → providerMessageId). SetNull: se a citada some, a resposta permanece.
  replyTo           Message?         @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replyToId         String?
  replies           Message[]        @relation("MessageReply")
  // Mídia recebida do lead (imagem/PDF). O binário fica no Supabase Storage
  // (bucket privado); aqui guardamos só o caminho do objeto + metadados. Null
  // em mensagens de texto e nas anteriores a este campo.
  mediaPath         String? // caminho no bucket (NÃO é URL; assinamos sob demanda)
  mediaType         String? // "image" | "document"
  mediaMime         String? // ex.: "application/pdf", "image/jpeg"
  fileName          String? // nome original p/ exibir/baixar ("contrato.pdf")
  createdAt         DateTime         @default(now())

  @@index([leadId, createdAt])
}

model Campaign {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  name            String
  messageTemplate String // contém {{nome}}
  status          CampaignStatus @default(DRAFT)
  dailyCap        Int? // teto diário p/ warm-up (null = usa default do env)
  leads           Lead[]
  outboundJobs    OutboundJob[]
  createdAt       DateTime       @default(now())

  @@index([userId])
}

model Qualification {
  // 1:1 com Lead
  id                   String   @id @default(cuid())
  lead                 Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId               String   @unique
  interestLevel        String?
  painPoint            String?
  segment              String?
  isDecisionMaker      Boolean?
  urgency              String?
  budget               String?
  preferredMeetingTime String?
  score                Int      @default(0) // espelhado em Lead.score (desnormalizado p/ listagem)
  summary              String?
  nextAction           String? // "ask_question" | "schedule_meeting" | "discard"
  raw                  Json // JSON bruto da IA (auditoria)
  updatedAt            DateTime @updatedAt
}

model Meeting {
  // 1:1 com Lead
  id                   String        @id @default(cuid())
  lead                 Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId               String        @unique
  status               MeetingStatus @default(PROPOSED)
  proposedSlots        Json // ISO datetimes propostos
  scheduledAt          DateTime?
  calendarEventId      String?
  meetingLink          String?
  // Lembretes já enviados ao lead (anti-duplicidade): véspera (~24h) e em cima da hora (~1h).
  remindedDayBeforeAt  DateTime?
  remindedHourBeforeAt DateTime?
  createdAt            DateTime      @default(now())
}

// Status de um agendamento de serviço (≠ MeetingStatus, que é "reunião de venda").
enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  REALIZADO
  FALTOU
  CANCELADO
}

// Agendamento de serviço: N por Lead (≠ Meeting, que é 1:1). Cobre recorrência e
// pacotes (sessões geradas antecipadamente, agrupadas por `seriesId`). Sem `userId`
// próprio — scoping por `lead.userId`, igual Meeting. Reaproveita o motor de
// lembretes véspera/1h (remindedDayBeforeAt/remindedHourBeforeAt).
model Appointment {
  id                   String            @id @default(cuid())
  lead                 Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId               String
  catalogItem          CatalogItem?      @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  catalogItemId        String?
  serviceName          String? // snapshot do serviço (sobrevive à exclusão do item)
  scheduledAt          DateTime
  status               AppointmentStatus @default(AGENDADO)
  note                 String?
  seriesId             String? // agrupa sessões de um mesmo pacote
  order                Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId              String? // comanda gerada quando REALIZADO
  remindedDayBeforeAt  DateTime?
  remindedHourBeforeAt DateTime?
  needsReview          Boolean           @default(false) // resposta do cliente ao lembrete aguarda conferência
  reviewReason         String? // ex.: "cliente confirmou", "cliente pediu remarcar", "cliente recusou"
  createdById          String
  createdBy            User              @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([leadId, scheduledAt])
  @@index([seriesId])
  @@index([status, scheduledAt])
  @@index([needsReview])
}

model OutboundJob {
  id               String            @id @default(cuid())
  lead             Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId           String
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])
  campaignId       String?
  kind             String // "template" | "freeform"
  content          String // texto renderizado (auditoria / freeform)
  templateName     String? // nome do template aprovado (quando kind=template)
  status           OutboundJobStatus @default(PENDING)
  attempts         Int               @default(0)
  deferCount       Int               @default(0) // deferimentos por falta de chip (anti-livelock)
  claimedAt        DateTime? // quando um worker travou em SENDING (p/ reaper de órfãos)
  lastError        String?
  scheduledFor     DateTime          @default(now())
  sentAt           DateTime?
  // qual chip enviou (auditoria + cap por número + roteamento de resposta)
  whatsAppNumber   WhatsAppNumber?   @relation(fields: [whatsAppNumberId], references: [id])
  whatsAppNumberId String?
  // resposta manual citando uma Message (id interno). O worker resolve o
  // providerMessageId/conteúdo p/ montar o `quoted` do Baileys ao enviar.
  replyToMessageId String?
  // Anexo de saída (operador enviou arquivo pela inbox): caminho no Supabase
  // Storage + metadados. O web sobe o arquivo e enfileira; o worker baixa o
  // buffer e envia pelo chip. Null em jobs de texto/campanha.
  mediaPath        String?
  mediaType        String? // "image" | "document" | "audio"
  mediaMime        String?
  fileName         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, scheduledFor])
  @@index([status, claimedAt]) // reaper varre SENDING órfãos por idade do lease
  @@index([leadId])
  @@index([campaignId])
  @@index([whatsAppNumberId, status, sentAt])
}

model WhatsAppNumber {
  id         String               @id @default(cuid())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  label      String // apelido operacional ("chip-01")
  phone      String // número do próprio chip, E.164 — único POR conta
  sessionDir String               @unique // subpasta em BAILEYS_AUTH_DIR (global, com prefixo do user)
  status     WhatsAppNumberStatus @default(CONNECTING)
  dailyCap   Int                  @default(30) // teto/dia deste chip (warm-up / disparo dormente)

  // ── Config de ATENDIMENTO (número = empresa) ───────────────────────────
  displayName                String? // nome público da empresa (cai p/ `label` se null)
  aiModel                    String? // modelo da IA que opera a resposta (ID do provider); null = padrão do tier
  systemPromptOverride       String? // prompt mestre completo; quando setado, SUBSTITUI o ATTENDANCE_SYSTEM padrão
  persona                    String? // tom/estilo do atendente ("formal", "descontraído", instruções)
  knowledgeBase              String? // FAQ / produtos / serviços (texto livre injetado no prompt)
  businessHours              String? // horário de atendimento em texto livre ("Seg–Sex 9h–18h")
  customInstructions         String? // instruções extras específicas da empresa
  autoReplyEnabled           Boolean @default(true) // IA responde automaticamente o inbound
  qualifyEnabled             Boolean @default(false) // roda qualificação/score (funil de vendas)
  scheduleEnabled            Boolean @default(false) // permite propor/agendar reunião
  salesEnabled               Boolean @default(false) // "Modo vendas": IA pode apresentar oferta e cobrar Pix (send_offer)
  // Texto dos lembretes de reunião ao lead (placeholders {{nome}} {{quando}} {{link}});
  // null/vazio = usa o texto padrão. Véspera (~24h) e em cima da hora (~1h).
  reminderDayBeforeTemplate  String?
  reminderHourBeforeTemplate String?

  // ── Timing & handoff do atendimento ────────────────────────────────────
  replyDelaySeconds       Int     @default(10) // janela de espera (debounce) antes de responder; junta msgs picadas
  firstReplyDelaySeconds  Int     @default(15) // espera específica da PRIMEIRA resposta da conversa
  autoPauseOnHumanReply   Boolean @default(true) // operador respondeu manual pelo zap → pausa a IA
  inactivityResumeMinutes Int     @default(0) // 0 = desligado; >0 = reativa a IA após N min sem interação
  contextResetMinutes     Int     @default(180) // silêncio > N min → IA zera o contexto (nova conversa); 0 = nunca zera

  pairingQr   String? // QR atual p/ pareamento (gravado pelo worker, lido pela UI; null quando conectado)
  lastError   String?
  connectedAt DateTime?
  bannedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  outboundJobs OutboundJob[]
  messages     Message[]
  leads        Lead[]
  offers       Offer[]
  authState    WhatsAppAuthState[] // credenciais Baileys persistidas no banco

  @@unique([userId, phone])
  @@index([userId])
  @@index([status])
}

// Token de confirmação de e-mail (one-time, guardamos só o hash).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Token de redefinição de senha (one-time, guardamos só o hash).
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime? // marca consumo (evita reuso)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Lead de consultoria captado na landing (formulário "fale com um consultor").
model ConsultantLead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  whatsapp  String
  plan      String? // plano de interesse
  message   String?
  source    String   @default("landing")
  status    String   @default("NOVO")
  createdAt DateTime @default(now())

  @@index([status])
}

// Configurações globais do app (key/value). Singleton de sistema, não por conta.
// Ex.: "landing.enabled" = "1"|"0" controla se a raiz mostra a landing de
// marketing ou vai direto pro login. Lido pela raiz; escrito pelo admin.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Heartbeat do worker (linha única "singleton"): a rota de health compara
// `now - beatAt` p/ detectar worker offline (deploy travado/crash).
model WorkerHeartbeat {
  id     String   @id
  beatAt DateTime
}

// Oferta que a IA pode apresentar/cobrar. Ligada a um número; várias por número.
model Offer {
  id               String         @id @default(cuid())
  userId           String // dono (tenant) — desnormalizado p/ query/isolamento
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsAppNumberId String
  whatsAppNumber   WhatsAppNumber @relation(fields: [whatsAppNumberId], references: [id], onDelete: Cascade)
  name             String // "Mentoria Fitness"
  description      String? // "Plano de treino + acompanhamento semanal"
  priceCents       Int // valor em centavos (BRL) — FONTE DE VERDADE do preço
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sales            Sale[]

  @@index([whatsAppNumberId, active])
}

// Uma cobrança gerada p/ um lead. Fonte de verdade do estado da venda.
model Sale {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offerId          String
  offer            Offer           @relation(fields: [offerId], references: [id])
  provider         PaymentProvider
  providerChargeId String // id da cobrança no gateway (chave de reconciliação)
  amountCents      Int // snapshot do priceCents no momento da cobrança
  status           SaleStatus      @default(PENDING)
  pixCopiaECola    String? // payload Pix copia-e-cola
  createdAt        DateTime        @default(now())
  paidAt           DateTime?

  @@unique([provider, providerChargeId]) // idempotência do webhook
  @@index([leadId])
}

// Estado de autenticação do Baileys persistido no banco (chave/valor por número).
model WhatsAppAuthState {
  id        String         @id @default(cuid())
  number    WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  numberId  String
  key       String
  value     String
  updatedAt DateTime       @updatedAt

  @@unique([numberId, key])
}
